# S3 Offloader — config
# Copy this to .env and fill in your values

MODELS_ROOT=~/models
S3_BUCKET=comfyui-medo
S3_PREFIX=models-offload/

# Optional platform label used by sync/snapshot logic
# Examples: runpod, vastai
PLATFORM_NAME=runpod

# Optional: if you use a named AWS profile
# AWS_PROFILE=default

# Or set inline (if not using ~/.aws/credentials)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=eu-west-3
